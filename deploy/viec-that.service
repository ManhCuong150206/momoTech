[Unit]
Description=Viec That API
After=network.target

[Service]
Type=simple
User=viecthat
Group=viecthat
# Chạy trong apps/api để tsx đọc apps/api/tsconfig.json (bật decorator cho NestJS).
WorkingDirectory=/opt/viec-that/apps/api
Environment=NODE_ENV=production
EnvironmentFile=/etc/viec-that/api.env
ExecStart=/usr/bin/node-24 --import tsx src/main.ts
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict

[Install]
WantedBy=multi-user.target
