PORT=3000
HOST=127.0.0.1
LOG_LEVEL=info

# Lịch sử tra cứu (PostgreSQL). Bỏ trống thì chạy không lịch sử.
# DATABASE_URL=postgres://viecthat:MAT_KHAU@127.0.0.1:5432/viecthat
HISTORY_TTL_DAYS=30
# Đặt true khi chạy sau HTTPS để cookie thiết bị có cờ Secure.
COOKIE_SECURE=false
# Giới hạn và dọn dẹp
HISTORY_MAX_PER_DEVICE=100
RATE_LIMIT_PER_MINUTE=30
# Đặt true khi API chạy sau Caddy.
TRUST_PROXY=false

# AI (VT07): AWS Bedrock Converse. Thông tin xác thực lấy từ IAM role hoặc đăng nhập SSO, không đặt khóa vào tệp này.
# BEDROCK_MODEL_ID=<model id hoặc inference profile đã được cấp quyền>
# AWS_REGION=<vùng của Sandbox>

# Địa điểm (VT08): Google Places API (New). Khóa nên giới hạn theo API và đặt hạn mức ngân sách.
# GOOGLE_MAPS_API_KEY=